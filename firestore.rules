rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /walks/{walkId} {
      allow read: if true;
      // Basic schema validation: ensure 'walkers' and 'startTime' fields exist on write
      allow write: if request.resource.data.keys().hasAll(['walkers', 'startTime']);
    }
    match /health/{healthId} {
      allow read: if true;
      // Basic schema validation: ensure 'type', 'date', and 'walker' fields exist on write
      allow write: if request.resource.data.keys().hasAll(['type', 'date', 'walker']);
    }
    match /walkers/{walkerId} {
      allow read: if true;
      allow write: if true;
    }
    match /line_users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
