rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Note: Public read access is required because the frontend (index.html) does not implement Authentication.
    // Ideally, this should be restricted to authenticated users (request.auth != null) if Auth is added in the future.
    match /walks/{walkId} {
      allow read: if true;
      // Basic schema validation for create and update
      allow create, update: if request.resource.data.keys().hasAll(['walkers', 'startTime']);
      allow delete: if true;
    }
    match /health/{healthId} {
      allow read: if true;
      // Basic schema validation for create and update
      allow create, update: if request.resource.data.keys().hasAll(['type', 'date', 'walker']);
      allow delete: if true;
    }
    match /walkers/{walkerId} {
      allow read: if true;
      allow write: if true;
    }
    match /line_users/{userId} {
      // Only accessed by Admin SDK (backend)
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
