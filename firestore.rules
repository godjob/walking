rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Note: Public read access is required because the frontend (index.html) does not implement Authentication.
    // Ideally, this should be restricted to authenticated users (request.auth != null) if Auth is added in the future.
    match /walks/{walkId} {
      allow read: if true;
      // Basic schema validation for create and update
      allow create, update: if request.resource.data.keys().hasAll(['walkers', 'startTime']);
      allow delete: if true;
    }
    match /health/{healthId} {
      allow read: if true;
      // Basic schema validation for create and update
      allow create, update: if request.resource.data.keys().hasAll(['type', 'date', 'walker']);
      allow delete: if true;
    }
    match /walkers/{walkerId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll([
        'stopDetectionRadius',
        'stopDetectionDuration',
        'locationInterval',
        'autoEndEnabled',
        'autoEndAfterStop',
        'gpsUpdateInterval',
        'minimumDistanceThreshold',
        'updatedAt',
        'updatedBy'
      ]) &&
      request.resource.data.stopDetectionRadius is int &&
      request.resource.data.stopDetectionDuration is int &&
      request.resource.data.locationInterval is int &&
      request.resource.data.autoEndEnabled is bool &&
      request.resource.data.autoEndAfterStop is int &&
      request.resource.data.gpsUpdateInterval is int &&
      request.resource.data.minimumDistanceThreshold is int;
    }
    match /line_users/{userId} {
      // Only accessed by Admin SDK (backend)
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
